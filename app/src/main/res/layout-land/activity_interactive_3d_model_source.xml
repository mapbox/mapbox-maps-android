<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.mapbox.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Landscape: a bottom sheet would leave no usable map area, so the controls
         become a side panel pinned to the leading edge instead. -->
    <LinearLayout
        android:id="@+id/controlPanel"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/bg_side_panel"
        android:orientation="vertical">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/controlPanelScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <include
                android:id="@+id/controls"
                layout="@layout/view_3d_model_controls" />

        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
